# Tesla Fleet API / home energy
# Create an application at https://developer.tesla.com/ with the
# energy_device_data scope. The client secret is only used by tesla_auth.py.
tesla_enabled: true          # false: make no Tesla requests; grid-window charging still works
tesla_data_source: "local"   # local: Powerwall Gateway; fleet: Tesla cloud Fleet API
tesla_gateway_url: "https://10.254.0.45"
tesla_gateway_username: "customer"
tesla_gateway_password: ""   # Custom local customer password; keep private
tesla_gateway_email: ""      # Tesla account email; some Gateway firmware requires it
tesla_gateway_timeout: 10
tesla_gateway_verify_tls: false  # Gateway normally uses a self-signed certificate
tesla_client_id: ""
tesla_client_secret: ""
tesla_redirect_uri: "https://your-registered-domain.example/tesla/callback"
tesla_api_base_url: "https://fleet-api.prd.na.vn.cloud.tesla.com"
tesla_token_url: "https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token"
tesla_token_cache: ".tesla-tokens.json"
tesla_timeout: 20
# Optional when the account contains more than one energy site:
# tesla_site_id: ""

# Hyundai BlueLink (for EV status)
bluelink_user: ""
bluelink_pass: ""
bluelink_pin:  ""              # required in the US
bluelink_region: "USA"      # for hyundai-kia-connect-api
bluelink_brand: "Hyundai"      # for hyundai-kia-connect-api

# Vehicle VIN (for status queries)
vehicle_vin: ""

# Wallbox Pulsar Plus (using the 'wallbox' PyPI lib)
wallbox_user: ""
wallbox_pass: ""
wallbox_region: "us"         # e.g. 'eu', 'us'

# Polling & logging
poll_interval: 300           # how often to poll sensors (in seconds)
log_level: "INFO"            # DEBUG, INFO, WARNING, ERROR

# Charger & power parameters
voltage: 240                 # system voltage in volts
step_size: 1                 # amps per step supported by charger
min_amps: 6                  # minimum charging current
max_amps: 40                 # max charging current your charger supports
hysteresis_watts: 250        # deadband to avoid rapid toggling (in watts)
default_amps: 9
grid_charge_start_hour: 23
grid_charge_end_hour: 6
grid_charge_fast : True
grid_charge_fast_amps : 40
# State-of-Charge thresholds
ev_target_soc: 80            # % to hit before stopping
ev_target_soc_solar_surplus: 100 # go higher instead of sending back to grid
bluelink_refresh_fail_count: 1
battery_soc_full_threshold_low: 50 # Powerwall level to stop solar charging of ev
battery_soc_full_threshold_high: 55 # Powerwall level to start solar charging of ev
# EV battery capacity
ev_battery_capacity_kwh: 84.0
